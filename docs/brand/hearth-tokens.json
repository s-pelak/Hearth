  "motion": {
    "duration": {
      "instant": 100,
      "quick": 150,
      "standard": 200,
      "gentle": 300,
      "flame-catch": 600
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "enter": [
        0,
        0,
        0,
        1
      ],
      "exit": [
        0.3,
        0,
        1,
        1
      ]
    }
  },
  "type": {
    "display": {
      "family": "Fraunces",
      "weight": 500,
      "size": 54,
      "lineHeight": 60,
      "use": "Onboarding and empty-state hero only"
    },
    "title-l": {
      "family": "Fraunces",
      "weight": 500,
      "size": 28,
      "lineHeight": 34,
      "use": "Screen titles"
    },
    "title-m": {
      "family": "Fraunces",
      "weight": 500,
      "size": 22,
      "lineHeight": 28,
      "use": "Section and dialog titles"
    },
    "lede": {
      "family": "Inter",
      "weight": 500,
      "size": 19,
      "lineHeight": 26,
      "use": "Intros, first lines"
    },
    "body": {
      "family": "Inter",
      "weight": 400,
      "size": 16,
      "lineHeight": 24,
      "use": "Messages, body text"
    },
    "body-s": {
      "family": "Inter",
      "weight": 400,
      "size": 14,
      "lineHeight": 20,
      "use": "Dense lists, secondary text"
    },
    "label": {
      "family": "Inter",
      "weight": 500,
      "size": 14,
      "lineHeight": 20,
      "use": "Buttons, tabs, inputs"
    },
    "caps": {
      "family": "Inter",
      "weight": 500,
      "size": 12,
      "lineHeight": 16,
      "use": "Section labels, caps +0.08em"
    },
    "caption": {
      "family": "Inter",
      "weight": 400,
      "size": 13,
      "lineHeight": 18,
      "use": "Captions, timestamps, sources"
    }
  },
  "elevation": {
    "flat": "none",
    "raised": "0 0 0 1px var(--hearth-line)",
    "float": "0 8px 24px rgba(18,34,43,0.14)"
  },
  "target": {
    "ios": 44,
    "android": 48,
    "web": 40
  },
  "state": {
    "hover": 0.08,
    "pressed": 0.12,
    "disabled": 0.4
  },
  "breakpoint": {
    "compact": 0,
    "medium": 600,
    "expanded": 1024
  }
